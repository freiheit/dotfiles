# Patterns match the target path and `*` does not cross `/`, so `**/*~` not `*~`.
**/*~
**/DEADJOE

# docs in base don't get installed to ~
*.md
*.txt

# Holds the GitHub OAuth token. .config/gh/config.yml is managed; this is not.
.config/gh/hosts.yml

# Holds the Steam Web API key (`[steam] api_key`); written by hand once per host, like gh/hosts.yml.
.config/deckdex/config.toml

renovate.json

# Claude Code secrets and machine state; the app owns these, never managed.
.claude/.env
.claude/.credentials.json
.claude/settings.local.json
.claude.json

{{ $ov := includeTemplate "openvox" . | fromJson -}}
{{ $workstation := and (eq $ov.role "workstation") (ne .chezmoi.username "root") -}}
{{ if not $workstation -}}
# Flatpak overrides (Obsidian, browsers, Discord, OpenDeck, Boatswain, Signal)
# and the Obsidian fallback install: Puppet workstations, non-root only.
# Ignoring the directory skips every override; the script by its target name.
.local/share/flatpak
.chezmoiscripts/obsidian-install.sh
{{ end -}}
{{ if not (and $workstation (lookPath "distrobox")) -}}
# Workstation distroboxes (Claude Desktop in ubuntu, Fastly CLI in fedora); the
# manifest, its hook files and the assemble script go together.
.config/distrobox
.chezmoiscripts/distrobox.sh
{{ end -}}
{{ if not (and $workstation (lookPath "steam")) -}}
# deckdex: same, plus Steam present. Ignoring the external skips the download.
.local/bin/deckdex
.chezmoiscripts/deckdex-cron.sh
{{ end -}}

{{ $claude := and (lookPath "claude") (ne .chezmoi.username "root") -}}
{{ $obsidian := or (stat "/var/lib/flatpak/app/md.obsidian.Obsidian") (stat (joinPath .chezmoi.homeDir ".local/share/flatpak/app/md.obsidian.Obsidian")) -}}
{{ if not $claude -}}
# Claude Code config: hosts with the claude CLI, non-root only.
.claude
.chezmoiscripts/lifeos-bootstrap.sh
{{ end -}}
{{ if not (and $claude $obsidian) -}}
# agentcairn: Claude Code plus Obsidian, which is how the vault gets read.
.agentcairn
.chezmoiscripts/agentcairn.sh
{{ end -}}
