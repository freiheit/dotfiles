# Patterns match the TARGET path, and `*` does not cross `/`. A bare `*~` here
# only caught top-level backups and let dot_bashrc.d/fzf.sh~ deploy to
# ~/.bashrc.d/fzf.sh~ on every host.
**/*~
DEADJOE

