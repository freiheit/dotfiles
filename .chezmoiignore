# Patterns match the target path and `*` does not cross `/`, so `**/*~` not `*~`.
**/*~
**/DEADJOE

# docs in base don't get installed to ~
*.md
*.txt

# Holds the GitHub OAuth token. .config/gh/config.yml is managed; this is not.
.config/gh/hosts.yml

# Holds the Steam Web API key (`[steam] api_key`); written by hand once per host, like gh/hosts.yml.
.config/deckdex/config.toml

renovate.json

{{ $ov := includeTemplate "openvox" . | fromJson -}}
{{ if not (and (eq $ov.role "workstation") (lookPath "steam") (ne .chezmoi.username "root")) -}}
# deckdex: Puppet workstations with Steam, non-root only. Ignoring the external
# skips the download; ignoring the script by its target name skips the run.
.local/bin/deckdex
.chezmoiscripts/deckdex-cron.sh
{{ end -}}
