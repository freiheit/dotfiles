---
# Public ssh material: host keys and public keys, all base64, none of it secret.
#
# Deliberately NO `checksum:` on these entries. A checksum pins exact file
# contents, so it would go stale the moment known_hosts picks up a new host or a
# key is rotated, and every such commit would need this file regenerated by hand.
# `ignore_detectors` is content-independent and needs no maintenance.
#
# Each entry below was verified to be load-bearing by staging a real change to
# the file and watching talisman fail without it -- these are not guesses.
#
# `filecontent` fires on the base64 in ssh keys. `filename` is needed on
# authorized_keys only: chezmoi's `private_` mode prefix makes the source path
# "private_dot_ssh/private_authorized_keys" match talisman's `private.*key`
# pattern. That is an artifact of chezmoi's filename encoding, not a real
# private key. The .pub files do not match that pattern and need no filename
# exclude.
#
# Private keys are NOT in this repo and must never be -- they live in 1Password
# (see dot_config/private_1Password/private_ssh/private_agent.toml). The
# detect-private-key pre-commit hook is not silenced here and still guards that.
fileignoreconfig:
  - filename: private_dot_ssh/private_known_hosts
    ignore_detectors: [filecontent]
  - filename: private_dot_ssh/private_authorized_keys
    ignore_detectors: [filecontent, filename]
  - filename: private_dot_ssh/id_rsa.pub
    ignore_detectors: [filecontent]
  - filename: private_dot_ssh/private_id_ecdsa.pub
    ignore_detectors: [filecontent]
  - filename: private_dot_ssh/private_id_ed25519.pub
    ignore_detectors: [filecontent]
version: "1.0"
