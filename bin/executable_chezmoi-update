#!/bin/bash

# Only accounts openvox-control marks `dotfiles: chezmoi` or `init` may appear
# here; a `keys` account has Puppet writing its authorized_keys and chezmoi
# would undo that. Puppet also pulls the `chezmoi` ones daily; this loop is
# the fast path.
ACCTS=(
    root@media1
    eric@media1
    root@freiheit-bots-el10
    eric@atlantic.devin.com
)
# A bare host gets these appended in turn until ssh itself stops failing (exit
# 255): bare on the LAN, real domain elsewhere, Tailscale from anywhere. A host
# that already has a dot is tried as-is only. Same scheme as openvox-control's
# scripts/apply-all.sh.
DOMAINS=('' ogazenh.art freiheit.wtf cheetah-dinosaur.ts.net)

ssh_acct() { # ssh_acct USER@HOST CMD
    local acct=$1 cmd=$2 user=${1%@*} host=${1#*@} d rc
    local -a tries
    if [[ $host == *.* ]]; then tries=(''); else tries=("${DOMAINS[@]}"); fi
    for d in "${tries[@]}"; do
        ssh -A -o ConnectTimeout=10 "${user}@${host}${d:+.$d}" "$cmd"
        rc=$?
        ((rc == 255)) || return "$rc"
        echo "== $acct: ssh to ${host}${d:+.$d} failed, trying the next name =="
    done
    return 255
}

# Recover clones stranded on orphaned history after a force-push. Resets only on
# true divergence -- a clone merely ahead may hold unpushed autoCommit work.
RESYNC='cd "$(chezmoi source-path)" && git fetch --quiet origin &&
    { git merge-base --is-ancestor HEAD origin/main ||
      git merge-base --is-ancestor origin/main HEAD ||
      { echo "== diverged, resetting to origin/main =="; git reset --hard origin/main; }; }'

echo === Commit all changes
chezmoi re-add

echo === Update from git
chezmoi update

echo === Commit and push
chezmoi git add .
chezmoi git commit
chezmoi git push

echo === Pulling updates down to elsewhere ===
echo === sudo ===
sudo -E bash -c "$RESYNC && chezmoi update"

echo === Looping through ACCTS to pull updates ===
for acct in "${ACCTS[@]}"; do
    echo "== Processing $acct =="
    ssh_acct "$acct" "$RESYNC && chezmoi update --apply"
done

echo === ALL DONE ===
