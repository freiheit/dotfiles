#!/bin/bash

ACCTS=(
    root@media1.ogazenh.art
    eric@media1.ogazenh.art
    root@freiheit-bots-el10.freiheit.wtf
    bots@freiheit-bots-el10.freiheit.wtf
)

# Pull-only clones land on orphaned history after a force-push, and then
# chezmoi update's git pull fails instead of updating. Behind or equal is the
# normal case and resets nothing. Ahead is left alone too -- autoCommit means a
# clone can hold real unpushed work, and throwing that away silently would be
# worse than the failure this is fixing. Only a genuinely diverged clone, where
# neither side contains the other, gets discarded and re-pointed at origin.
RESYNC='cd "$(chezmoi source-path)" &&
    git fetch --quiet origin &&
    { git merge-base --is-ancestor HEAD origin/main ||
      git merge-base --is-ancestor origin/main HEAD ||
      { echo "== history diverged, resetting to origin/main =="
        git reset --hard origin/main; }; }'

echo === Commit all changes
chezmoi re-add

echo === Update from git
chezmoi update

echo === Commit and push
chezmoi git add .
chezmoi git commit
chezmoi git push

echo === Pulling updates down to elsewhere ===
echo === sudo ===
sudo -E bash -c "$RESYNC && chezmoi update"

echo === Looping through ACCTS to pull updates ===
# "${ACCTS[@]}" not $ACCTS: the latter expands to the first element only, so
# this loop silently processed one account out of four.
for acct in "${ACCTS[@]}"; do
    echo "== Processing $acct =="
    ssh -A "$acct" "$RESYNC && chezmoi update --apply"
done

echo === ALL DONE ===
