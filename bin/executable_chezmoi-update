#!/bin/bash

echo === Commit all changes
chezmoi managed | xargs chezmoi add --recursive=false --keep-going --verbose

echo === Update from git
chezmoi update

echo === Commit and push
chezmoi git add .
chezmoi git commit
chezmoi git push

echo === Pulling updates down to elsewhere ===
echo === sudo ===
sudo -E chezmoi update
echo === distrobox-list/enter ===
distrobox-list  | 
  cut -d'|' -f2 |
  tr -d ' '     | 
  tail -n +2    | 
  xargs -I{}    \
    distrobox-enter --name {} -- chezmoi update
