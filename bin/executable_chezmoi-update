#!/bin/bash

ACCTS=(
    root@media1.ogazenh.art
    eric@media1.ogazenh.art
    root@freiheit-bots-el10.freiheit.wtf
    bots@freiheit-bots-el10.freiheit.wtf
)

# Recover clones stranded on orphaned history after a force-push. Resets only on
# true divergence -- a clone merely ahead may hold unpushed autoCommit work.
RESYNC='cd "$(chezmoi source-path)" && git fetch --quiet origin &&
    { git merge-base --is-ancestor HEAD origin/main ||
      git merge-base --is-ancestor origin/main HEAD ||
      { echo "== diverged, resetting to origin/main =="; git reset --hard origin/main; }; }'

echo === Commit all changes
chezmoi re-add

echo === Update from git
chezmoi update

echo === Commit and push
chezmoi git add .
chezmoi git commit
chezmoi git push

echo === Pulling updates down to elsewhere ===
echo === sudo ===
sudo -E bash -c "$RESYNC && chezmoi update"

echo === Looping through ACCTS to pull updates ===
for acct in "${ACCTS[@]}"; do
    echo "== Processing $acct =="
    ssh -A "$acct" "$RESYNC && chezmoi update --apply"
done

echo === ALL DONE ===
