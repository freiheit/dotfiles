#!/bin/bash

ACCTS=(
    root@media1.ogazenh.art
    eric@media1.ogazenh.art
    root@freiheit-bots.freiheit.wtf
    bots@freiheit-bots.freiheit.wtf
)

echo === Commit all changes
chezmoi re-add

echo === Update from git
chezmoi update

echo === Commit and push
chezmoi git add .
chezmoi git commit
chezmoi git push

echo === Pulling updates down to elsewhere ===
echo === sudo ===
sudo -E chezmoi update

echo === Looping through ACCTS to pull updates ===
for acct in $ACCTS; do
    echo == Processing $acct ==
    ssh -A $acct chezmoi update --apply
done

echo === ALL DONE ===
