#!/bin/bash

# ujust update
## under hood, runs:

# Source brew if we are not in an interactive session
[[ $- != *i* ]] && source <(/home/linuxbrew/.linuxbrew/bin/brew shellenv)

#/usr/bin/topgrade --config /usr/share/ublue-os/topgrade.toml --keep
/usr/bin/topgrade --config /usr/share/ublue-os/topgrade.toml --skip-notify

distrobox-list  | 
  cut -d'|' -f2 |
  tr -d ' '     | 
  tail -n +2    | 
  xargs -I{}    \
    distrobox-enter --name {} -- sudo yum upgrade
