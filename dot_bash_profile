# .bash_profile

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
    . ~/.bashrc
fi

if which fedora-repoquery &> /dev/null; then
  (
    . /etc/os-release
    # VERSION_ID = 41
    fedora-repoquery --list | grep -E '^f' | grep -v -E 'pending$' | grep -A1 "^f${VERSION_ID}" | grep -v "^f${VERSION_ID}"
  )
fi

# User specific environment and startup programs


OP_AUTH_SOCK=$HOME/.1password/agent.sock
if [[ -S $OP_AUTH_SOCK && -r $OP_AUTH_SOCK && -w $OP_AUTH_SOCK ]]; then
   SSH_AUTH_SOCK=$OP_AUTH_SOCK
   export SSH_AUTH_SOCK
elif [[ -z "$SSH_AUTH_SOCK" ]]; then
  if which keychain &> /dev/null; then
    eval `keychain  --ignore-missing --quick --quiet --eval id_ecdsa id_rsa id_ed25519`
  else
    eval `ssh-agent -s`
  fi
fi
