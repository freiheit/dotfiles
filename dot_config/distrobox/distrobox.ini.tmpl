# Assembled by .chezmoiscripts/run_onchange_after_distrobox.sh.tmpl, which only
# creates boxes that do not exist yet. Hooks and packages bake in at creation:
# a change here reaches an existing box only through
# `distrobox assemble create --replace`, which rebuilds it from scratch.
[ubuntu]
image=quay.io/toolbx/ubuntu-toolbox:latest
nvidia=true
# Claude Desktop apt repo. The key is Anthropic's release signing key
# (31DD DE24 DDFA B679 F42D 7BD2 BAA9 29FF 1A7E CACE), shipped alongside this
# file rather than fetched, so pre-init needs no curl; the same key is at
# https://downloads.claude.ai/claude-desktop/key.asc.
pre_init_hooks=install -Dm0644 {{ .chezmoi.homeDir }}/.config/distrobox/claude-desktop-archive-keyring.asc /usr/share/keyrings/claude-desktop-archive-keyring.asc
pre_init_hooks=echo 'deb [signed-by=/usr/share/keyrings/claude-desktop-archive-keyring.asc] https://downloads.claude.ai/claude-desktop/apt/stable stable main' > /etc/apt/sources.list.d/claude-desktop.list
additional_packages=claude-desktop
exported_apps=com.anthropic.Claude
init_hooks=install -Dm0755 {{ .chezmoi.homeDir }}/.config/distrobox/claude-desktop-cache-isolation /usr/local/bin/claude-desktop
